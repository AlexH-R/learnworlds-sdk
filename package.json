{
  "name": "@alexh-r/learnworlds-sdk",
  "version": "0.1.1",
  "description": "Unofficial typed TypeScript SDK for the LearnWorlds API v2",
  "author": "Alejandro Hernández Rosa",
  "license": "MIT",
  "keywords": [
    "learnworlds",
    "sdk",
    "api",
    "typescript",
    "lms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexH-R/learnworlds-sdk.git"
  },
  "homepage": "https://github.com/AlexH-R/learnworlds-sdk#readme",
  "bugs": {
    "url": "https://github.com/AlexH-R/learnworlds-sdk/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
